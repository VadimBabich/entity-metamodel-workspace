{
  "realm": "workspace",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "workspace-api",
      "description": "Access to the workspace API; puts the API's audience into the access token.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "workspace-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "workspace-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "workspace-ui",
      "name": "Workspace UI (development)",
      "description": "A browser client for the future UI: public, authorization code with PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8080/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "defaultClientScopes": ["workspace-api", "profile", "email"]
    },
    {
      "clientId": "workspace-dev-cli",
      "name": "Development command line (local stack only)",
      "description": "Password grant for curl smoke tests on the local stack. Never enable outside it.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": ["workspace-api", "profile"]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "email": "alice@example.org",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Example",
      "email": "bob@example.org",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    }
  ]
}

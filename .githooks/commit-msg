#!/usr/bin/env bash
#
# Enable once per clone:  git config core.hooksPath .githooks
#
# Refuses an assistant's name or attribution in the message. The Guards workflow re-checks every
# pushed commit.

set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"
readonly repository_root

"${repository_root}/.github/scripts/check-commit-messages.sh" file "$1"
